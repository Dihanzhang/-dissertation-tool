# Copy this file to .env and fill in your values.
# Never commit .env to git.

# --- LLM provider ---
LLM_PROVIDER=anthropic           # "anthropic" | "openai"
ANTHROPIC_API_KEY=sk-ant-...     # required if LLM_PROVIDER=anthropic
OPENAI_API_KEY=sk-...            # required if LLM_PROVIDER=openai

LLM_MODEL_PAID=claude-opus-4-8   # paid tier model (explicit string — never "latest")

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# --- Submission Pass ---
PASS_DURATION_DAYS=30
MAX_UPLOAD_BYTES=10485760
SITE_URL=https://dissertation-tool.netlify.app
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1

# --- Review behaviour ---
HEAVY_EDIT_THRESHOLD=0.40        # change ratio above which a suggestion is "heavy"

# --- Development ---
TEST_MODE=true                   # true = unlimited credits, bypass payment (dev only)
